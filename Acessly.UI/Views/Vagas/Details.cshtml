@using Acessly.UI.Models.ViewModels
@model VagaViewModel
@{
    ViewData["Title"] = "Detalhes da Vaga";
}

<div class="card-glass mb-4" style="max-width: 680px; margin:auto;">
    <h3 class="fw-bold mb-3"><i class="bi bi-briefcase"></i> Detalhes da Vaga</h3>
    <dl class="row mb-0">
        <dt class="col-sm-4">Título:</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>
        <dt class="col-sm-4">Descrição:</dt>
        <dd class="col-sm-8">@Model.Descricao</dd>
        <dt class="col-sm-4">Tipo de Vaga:</dt>
        <dd class="col-sm-8">@Model.TipoVaga</dd>
        <dt class="col-sm-4">Cidade:</dt>
        <dd class="col-sm-8">@Model.Cidade</dd>
        <dt class="col-sm-4">Estado:</dt>
        <dd class="col-sm-8">@Model.Estado</dd>
        <dt class="col-sm-4">Salário:</dt>
        <dd class="col-sm-8">@Model.Salario.ToString("C")</dd>
        <dt class="col-sm-4">Acessibilidade oferecida:</dt>
        <dd class="col-sm-8">@Model.AcessibilidadeOferecida</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.IdVaga" class="btn btn-outline-light mt-3"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>
