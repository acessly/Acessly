@using Acessly.UI.Models.ViewModels
@model List<VagaViewModel>
@{
    ViewData["Title"] = "Vagas";
}

<div class="card-glass mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-briefcase"></i> Vagas</h2>
            <p class="text-white-50 mb-0">Gerencie as vagas e oportunidades disponíveis para candidatos.</p>
        </div>
        <div>
            <a class="btn btn-white" href="@Url.Action("Create")"><i class="bi bi-plus-lg"></i> Nova Vaga</a>
        </div>
    </div>
</div>

<div class="table-responsive card-glass mb-4">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Descrição</th>
                <th>Tipo</th>
                <th>Cidade</th>
                <th>Estado</th>
                <th>Salário</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vaga in Model)
            {
                <tr>
                    <td>@vaga.IdVaga</td>
                    <td>@vaga.Titulo</td>
                    <td>@vaga.Descricao</td>
                    <td>@vaga.TipoVaga</td>
                    <td>@vaga.Cidade</td>
                    <td>@vaga.Estado</td>
                    <td>@vaga.Salario.ToString("C")</td>
                    <td class="text-end">
                        <a class="btn btn-outline-light btn-sm" href="@Url.Action("Details", new { id = vaga.IdVaga })"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-outline-light btn-sm" href="@Url.Action("Edit", new { id = vaga.IdVaga })"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", new { id = vaga.IdVaga })"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
