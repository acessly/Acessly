@using Acessly.UI.Models.ViewModels
@model VagaViewModel
@{
    ViewData["Title"] = "Editar Vaga";
}

<div class="card-glass mb-4" style="max-width: 700px; margin:auto;">
    <h2 class="fw-bold mb-2"><i class="bi bi-pencil-square"></i> Editar Vaga</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="IdVaga" />
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Descricao" class="form-label"></label>
            <textarea asp-for="Descricao" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Descricao" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TipoVaga" class="form-label"></label>
            <select asp-for="TipoVaga" class="form-select">
                <option>Remoto</option>
                <option>Presencial</option>
                <option>Híbrido</option>
            </select>
            <span asp-validation-for="TipoVaga" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cidade" class="form-label"></label>
            <input asp-for="Cidade" class="form-control" />
            <span asp-validation-for="Cidade" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <input asp-for="Estado" class="form-control" />
            <span asp-validation-for="Estado" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Salario" class="form-label"></label>
            <input asp-for="Salario" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Salario" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AcessibilidadeOferecida" class="form-label"></label>
            <input asp-for="AcessibilidadeOferecida" class="form-control" />
            <span asp-validation-for="AcessibilidadeOferecida" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-white mt-2"><i class="bi bi-check-circle"></i> Salvar Alterações</button>
        <a asp-action="Index" class="btn btn-secondary mt-2"><i class="bi bi-arrow-left"></i> Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
