@using Acessly.UI.Models.ViewModels
@model UsuarioViewModel
@{
    ViewData["Title"] = "Novo Usuário";
}

<div class="card-glass mb-4" style="max-width: 640px; margin:auto;">
    <h2 class="fw-bold mb-2"><i class="bi bi-person-plus"></i> Criar Usuário</h2>
    <form asp-action="Create" method="post" class="mt-2">
        <div class="mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" type="password" />
            <span asp-validation-for="Senha" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TipoUsuario" class="form-label"></label>
            <select asp-for="TipoUsuario" class="form-select">
                <option value="Candidato">Candidato</option>
                <option value="Empresa">Empresa</option>
            </select>
            <span asp-validation-for="TipoUsuario" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-white mt-2"><i class="bi bi-check-circle"></i> Salvar</button>
        <a asp-action="Index" class="btn btn-secondary mt-2"><i class="bi bi-arrow-left"></i> Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
