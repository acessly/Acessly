@using Acessly.UI.Models.ViewModels
@model CandidatoViewModel
@{
    ViewData["Title"] = "Detalhes do Candidato";
}

<div class="card-glass mb-4" style="max-width: 620px; margin:auto;">
    <h3 class="fw-bold mb-3"><i class="bi bi-person"></i> Detalhes do Candidato</h3>
    <dl class="row mb-0">
        <dt class="col-sm-4">Tipo Deficiência:</dt>
        <dd class="col-sm-8">@Model.TipoDeficiencia</dd>
        <dt class="col-sm-4">Habilidades:</dt>
        <dd class="col-sm-8">@Model.Habilidades</dd>
        <dt class="col-sm-4">Experiência:</dt>
        <dd class="col-sm-8">@Model.Experiencia</dd>
        <dt class="col-sm-4">Acessibilidade:</dt>
        <dd class="col-sm-8">@Model.AcessibilidadeNecessaria</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.IdCandidato" class="btn btn-outline-light mt-3"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Voltar</a>
</div>
