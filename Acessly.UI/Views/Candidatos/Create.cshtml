@using Acessly.UI.Models.ViewModels
@model CandidatoViewModel
@{
    ViewData["Title"] = "Novo Candidato";
}

<div class="card-glass mb-4" style="max-width: 700px; margin:auto;">
    <h2 class="fw-bold mb-2"><i class="bi bi-person-plus"></i> Criar Candidato</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="IdUsuario" class="form-label">ID do Usuário</label>
            <input asp-for="IdUsuario" type="number" class="form-control" placeholder="Digite o ID do usuário" />
            <span asp-validation-for="IdUsuario" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TipoDeficiencia" class="form-label"></label>
            <input asp-for="TipoDeficiencia" class="form-control" />
            <span asp-validation-for="TipoDeficiencia" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Habilidades" class="form-label"></label>
            <input asp-for="Habilidades" class="form-control" />
            <span asp-validation-for="Habilidades" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Experiencia" class="form-label"></label>
            <input asp-for="Experiencia" class="form-control" />
            <span asp-validation-for="Experiencia" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AcessibilidadeNecessaria" class="form-label"></label>
            <input asp-for="AcessibilidadeNecessaria" class="form-control" />
            <span asp-validation-for="AcessibilidadeNecessaria" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-white mt-2"><i class="bi bi-check-circle"></i> Salvar</button>
        <a asp-action="Index" class="btn btn-secondary mt-2"><i class="bi bi-arrow-left"></i> Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
