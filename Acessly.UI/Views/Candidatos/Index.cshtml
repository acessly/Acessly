@using Acessly.UI.Models.ViewModels
@model List<CandidatoViewModel>
@{
    ViewData["Title"] = "Candidatos";
}

<div class="card-glass mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-people"></i> Candidatos</h2>
            <p class="text-white-50 mb-0">Candidate profiles, abilities and accessibility needs.</p>
        </div>
        <div>
            <a class="btn btn-white" href="@Url.Action("Create")"><i class="bi bi-person-plus"></i> Novo Candidato</a>
        </div>
    </div>
</div>
<div class="table-responsive card-glass mb-4">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Deficiência</th>
                <th>Habilidades</th>
                <th>Experiência</th>
                <th>Acessibilidade</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var candidato in Model)
            {
                <tr>
                    <td>@candidato.IdCandidato</td>
                    <td>@candidato.TipoDeficiencia</td>
                    <td>@candidato.Habilidades</td>
                    <td>@candidato.Experiencia</td>
                    <td>@candidato.AcessibilidadeNecessaria</td>
                    <td class="text-end">
                        <a class="btn btn-outline-light btn-sm" href="@Url.Action("Details", new { id = candidato.IdCandidato })"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-outline-light btn-sm" href="@Url.Action("Edit", new { id = candidato.IdCandidato })"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-outline-danger btn-sm" href="@Url.Action("Delete", new { id = candidato.IdCandidato })"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
