@using Acessly.UI.Models.ViewModels
@model CandidaturaViewModel
@{
    ViewData["Title"] = "Excluir Candidatura";
}

<div class="card-glass mb-4" style="max-width: 600px; margin:auto;">
    <h3 class="fw-bold mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Confirmar Exclusão</h3>
    <div class="alert alert-danger">
        Tem certeza que deseja excluir a candidatura de ID @Model.IdCandidatura?
    </div>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCandidatura" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmar</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Cancelar</a>
        </div>
    </form>
</div>
