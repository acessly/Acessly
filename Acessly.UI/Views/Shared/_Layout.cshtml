<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Acessly</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">

    <!-- Navbar moderna e clean -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black shadow-sm sticky-top">
        <div class="container py-2">
            <!-- Logo e nome -->
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <i class="bi bi-universal-access-circle fs-3 text-primary"></i>
                <div class="d-flex flex-column">
                    <span class="fw-bold fs-5 text-white">Acessly</span>
                    <small class="text-muted" style="font-size: 0.7rem; line-height: 1;">Gestão Acessível</small>
                </div>
            </a>

            <!-- Botão hambúrguer (mobile) -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navAcessly" aria-controls="navAcessly" aria-expanded="false" aria-label="Alternar navegação">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Links de navegação -->
            <div class="collapse navbar-collapse" id="navAcessly">
                <ul class="navbar-nav ms-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "Usuarios")">
                            <i class="bi bi-person-circle me-1"></i> Usuários
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "Empresas")">
                            <i class="bi bi-building me-1"></i> Empresas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "Candidatos")">
                            <i class="bi bi-people-fill me-1"></i> Candidatos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "Vagas")">
                            <i class="bi bi-briefcase me-1"></i> Vagas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "Candidaturas")">
                            <i class="bi bi-send-check me-1"></i> Candidaturas
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 rounded hover-bg" href="@Url.Action("Index", "SuportesEmpresas")">
                            <i class="bi bi-life-preserver me-1"></i> Suportes
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Conteúdo principal -->
    <main class="container flex-grow-1 py-4">
        @RenderBody()
    </main>

    <!-- Footer minimalista -->
    <footer class="bg-black text-center py-3 mt-auto border-top border-secondary">
        <small class="text-muted">&copy; 2025 Acessly - Plataforma de Gestão Acessível</small>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <style>
        /* Efeito hover nos links de navegação */
        .hover-bg:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transition: background-color 0.3s ease;
        }

        /* Transição suave para mobile menu */
        .navbar-collapse {
            transition: all 0.3s ease-in-out;
        }
    </style>

</body>
</html>
