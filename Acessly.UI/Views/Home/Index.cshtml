                </li>
                <li class="mb-2">
                    <i class="bi bi-person-badge me-2"></i>Rodrigo (RM560759)
                    <a href="https://github.com/RodrygoYamasaki" target="_blank" class="text-info ms-2"><i class="bi bi-github"></i></a>
                </li>
                <li class="mb-2">
                    <i class="bi bi-person-badge me-2"></i>Patrick (RM559271)
                    <a href="https://github.com/castropatrick" target="_blank" class="text-info ms-2"><i class="bi bi-github"></i></a>
                </li>
            </ul>
