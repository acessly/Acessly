    <div class="col-md-6">
        <div class="card-glass h-100 p-4">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                Público-alvo
            </h5>
            <ul class="list-unstyled text-white-50">
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Pessoas com deficiência buscando trabalho</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Empresas que praticam contratação inclusiva</li>
                <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Instituições de empregabilidade e diversidade</li>
            </ul>
