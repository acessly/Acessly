@{
    ViewData["Title"] = "Acessly - Inclusão e Oportunidade";
}

<!-- Hero Section - Boas-vindas -->
<div class="card-glass mb-5 p-5 text-center">
    <div class="mb-4">
        <i class="bi bi-universal-access-circle text-primary" style="font-size: 4rem;"></i>
    </div>
    <h1 class="fw-bold mb-3 display-5">Bem-vindo ao Acessly</h1>
    <p class="lead text-white-50 mb-4">Conectando talentos PCD a oportunidades reais de trabalho</p>
    <p class="fs-6 text-light mx-auto" style="max-width: 900px;">
        O Brasil possui <strong class="text-primary">17,2 milhões</strong> de pessoas com deficiência (8,4% da população),
        mas apenas <strong class="text-warning">28,3%</strong> dos PCDs em idade produtiva participam do mercado de trabalho,
        comparado a <strong>66,3%</strong> da média nacional.
    </p>
</div>

<!-- Três pilares principais -->
<div class="row g-4 mb-5">
    <div class="col-lg-4">
        <div class="card-glass h-100 p-4">
            <div class="text-center mb-3">
                <i class="bi bi-bar-chart-line text-danger" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold text-center mb-3">O Desafio</h5>
            <ul class="list-unstyled text-white-50 small">
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i>Apenas <strong>28,3%</strong> dos PCDs em idade produtiva trabalham</li>
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i>Somente <strong>34,3%</strong> têm carteira assinada</li>
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i>Salário médio de <strong>R$ 1.639</strong> (62% da média nacional)</li>
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i><strong>7 em cada 10</strong> PCDs fora do mercado</li>
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i>Falta de transparência sobre acessibilidade</li>
                <li class="mb-2"><i class="bi bi-arrow-right-short text-muted me-2"></i>Processos seletivos pouco adaptados</li>
            </ul>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-glass h-100 p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-lightbulb text-warning" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold mb-3">Nossa Solução</h5>
            <p class="text-white-50 small mb-4">
                O Acessly conecta pessoas com deficiência a oportunidades reais de forma <strong>inclusiva, transparente e justa</strong>,
                promovendo match entre candidatos e empresas baseado em competências e acessibilidade.
            </p>
            <div class="d-flex flex-column gap-2">
                <span class="badge bg-primary bg-opacity-25 text-light py-2"><i class="bi bi-check-circle me-2"></i>Competências validadas</span>
                <span class="badge bg-primary bg-opacity-25 text-light py-2"><i class="bi bi-check-circle me-2"></i>Match real entre perfil e vaga</span>
                <span class="badge bg-primary bg-opacity-25 text-light py-2"><i class="bi bi-check-circle me-2"></i>Transparência total</span>
                <span class="badge bg-primary bg-opacity-25 text-light py-2"><i class="bi bi-check-circle me-2"></i>Dignidade e equidade</span>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-glass h-100 p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-bullseye text-success" style="font-size: 2.5rem;"></i>
            </div>
            <h5 class="fw-bold mb-3">Nosso Objetivo</h5>
            <p class="text-white-50 small mb-4">
                Reduzir ativamente o gap de empregabilidade e renda das PCDs no Brasil.
                Facilitar inclusão sustentável conectando empresas e talentos em uma plataforma acessível e transparente.
            </p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <span class="badge bg-light text-dark px-3 py-2">Inclusão</span>
                <span class="badge bg-light text-dark px-3 py-2">Equidade</span>
                <span class="badge bg-light text-dark px-3 py-2">Acessibilidade</span>
            </div>
        </div>
    </div>
</div>

<!-- Alinhamento com o futuro do trabalho -->
<div class="card-glass mb-5 p-4">
    <h5 class="fw-bold mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-rocket-takeoff text-info"></i>
        Alinhamento com o Futuro do Trabalho
    </h5>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="d-flex gap-3 align-items-start">
                <i class="bi bi-laptop text-primary fs-4"></i>
                <div>
                    <h6 class="fw-semibold mb-1">Digitalização Inclusiva</h6>
                    <p class="text-white-50 small mb-0">Tecnologia democratizando oportunidades com trabalho remoto/híbrido</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-3 align-items-start">
                <i class="bi bi-people text-success fs-4"></i>
                <div>
                    <h6 class="fw-semibold mb-1">Diversidade Estratégica</h6>
                    <p class="text-white-50 small mb-0">Inclusão como inovação e diferencial competitivo</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-3 align-items-start">
                <i class="bi bi-globe text-warning fs-4"></i>
                <div>
                    <h6 class="fw-semibold mb-1">Agenda ESG</h6>
                    <p class="text-white-50 small mb-0">Práticas alinhadas ao ODS 10 (Redução das Desigualdades)</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="d-flex gap-3 align-items-start">
                <i class="bi bi-house-heart text-danger fs-4"></i>
                <div>
                    <h6 class="fw-semibold mb-1">Ambientes Adaptáveis</h6>
                    <p class="text-white-50 small mb-0">Workplaces centrados nas pessoas e suas necessidades</p>
                </div>
            </div>
        </div>
    </div>
</div>

