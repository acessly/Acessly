@using Acessly.UI.Models.ViewModels
@model List<UsuarioViewModel>
@{
    ViewData["Title"] = "Usuários";
}

<div class="card-glass mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-person-circle"></i> Usuários</h2>
            <p class="text-white-50 mb-0">Liste, pesquise e gerencie todos os usuários da plataforma.</p>
        </div>
        <div>
            <a class="btn btn-white" href="@Url.Action("Create")"><i class="bi bi-person-plus"></i> Novo Usuário</a>
        </div>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model != null && Model.Any())
{
    <div class="table-responsive card-glass mb-4">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-hash"></i> ID</th>
                    <th><i class="bi bi-person"></i> Nome</th>
                    <th><i class="bi bi-envelope"></i> Email</th>
                    <th><i class="bi bi-award"></i> Tipo</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.IdUsuario</td>
                        <td>@usuario.Nome</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.TipoUsuario</td>
                        <td class="text-end">
                            <a class="btn btn-outline-light btn-sm" title="Ver detalhes" href="@Url.Action("Details", new { id = usuario.IdUsuario })"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-outline-light btn-sm" title="Editar" href="@Url.Action("Edit", new { id = usuario.IdUsuario })"><i class="bi bi-pencil"></i></a>
                            <a class="btn btn-outline-danger btn-sm" title="Excluir" href="@Url.Action("Delete", new { id = usuario.IdUsuario })"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card-glass text-center p-4">
        <p class="text-white-50 mb-0">Nenhum usuário cadastrado ainda.</p>
    </div>
}
