@using Acessly.UI.Models.ViewModels
@model EmpresaViewModel
@{
    ViewData["Title"] = "Detalhes da Empresa";
}

<div class="card-glass mb-4" style="max-width: 700px; margin:auto;">
    <h2 class="fw-bold mb-3">
        <i class="bi bi-info-circle"></i> Detalhes da Empresa
    </h2>

    <dl class="row">
        <dt class="col-sm-4"><i class="bi bi-hash"></i> ID</dt>
        <dd class="col-sm-8">@Model.IdEmpresa</dd>

        <dt class="col-sm-4"><i class="bi bi-person"></i> ID do Usuário</dt>
        <dd class="col-sm-8">@Model.IdUsuario</dd>

        <dt class="col-sm-4"><i class="bi bi-building"></i> Nome</dt>
        <dd class="col-sm-8">@Model.Nome</dd>

        <dt class="col-sm-4"><i class="bi bi-briefcase"></i> Setor</dt>
        <dd class="col-sm-8">@Model.Setor</dd>

        <dt class="col-sm-4"><i class="bi bi-star"></i> Acessibilidade</dt>
        <dd class="col-sm-8">
            @if (Model.NivelAcessibilidade == "Alto")
            {
                <span class="badge bg-success">Alto</span>
            }
            else if (Model.NivelAcessibilidade == "Medio")
            {
                <span class="badge bg-warning">Médio</span>
            }
            else
            {
                <span class="badge bg-secondary">Baixo</span>
            }
        </dd>

        <dt class="col-sm-4"><i class="bi bi-globe"></i> Site</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Site))
            {
                <a href="@Model.Site" target="_blank" class="text-white">
                    @Model.Site <i class="bi bi-box-arrow-up-right"></i>
                </a>
            }
            else
            {
                <span class="text-muted">Não informado</span>
            }
        </dd>

        <dt class="col-sm-4"><i class="bi bi-card-text"></i> Descrição</dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                @Model.Descricao
            }
            else
            {
                <span class="text-muted">Sem descrição</span>
            }
        </dd>
    </dl>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.IdEmpresa" class="btn btn-white">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.IdEmpresa" class="btn btn-danger">
            <i class="bi bi-trash"></i> Excluir
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>
