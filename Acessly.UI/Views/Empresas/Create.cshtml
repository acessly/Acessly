@using Acessly.UI.Models.ViewModels
@model EmpresaViewModel
@{
    ViewData["Title"] = "Nova Empresa";
}

<div class="card-glass mb-4" style="max-width: 700px; margin:auto;">
    <h2 class="fw-bold mb-3">
        <i class="bi bi-building-add"></i> Criar Nova Empresa
    </h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label asp-for="IdUsuario" class="form-label">
                <i class="bi bi-person"></i> ID do Usuário
            </label>
            <input asp-for="IdUsuario" type="number" class="form-control" placeholder="Digite o ID do usuário" />
            <span asp-validation-for="IdUsuario" class="text-danger small"></span>
            <small class="form-text text-muted">Digite o ID do usuário que será associado a esta empresa</small>
        </div>

        <div class="mb-3">
            <label asp-for="Nome" class="form-label">
                <i class="bi bi-building"></i> Nome da Empresa
            </label>
            <input asp-for="Nome" class="form-control" placeholder="Ex: Tech Solutions Ltda" />
            <span asp-validation-for="Nome" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Setor" class="form-label">
                <i class="bi bi-briefcase"></i> Setor
            </label>
            <input asp-for="Setor" class="form-control" placeholder="Ex: Tecnologia, Saúde, Educação..." />
            <span asp-validation-for="Setor" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NivelAcessibilidade" class="form-label">
                <i class="bi bi-star"></i> Nível de Acessibilidade
            </label>
            <select asp-for="NivelAcessibilidade" class="form-select">
                <option value="">Selecione...</option>
                <option value="Alto">Alto</option>
                <option value="Medio">Médio</option>
                <option value="Baixo">Baixo</option>
            </select>
            <span asp-validation-for="NivelAcessibilidade" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Site" class="form-label">
                <i class="bi bi-globe"></i> Site (opcional)
            </label>
            <input asp-for="Site" type="url" class="form-control" placeholder="https://exemplo.com.br" />
            <span asp-validation-for="Site" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descricao" class="form-label">
                <i class="bi bi-card-text"></i> Descrição (opcional)
            </label>
            <textarea asp-for="Descricao" rows="4" class="form-control" placeholder="Descreva a empresa e suas atividades..."></textarea>
            <span asp-validation-for="Descricao" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-white">
                <i class="bi bi-check-circle"></i> Salvar Empresa
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
